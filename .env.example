# Environment Configuration
# Copy this file to .env and update with your values

# Database
DATABASE_URL=sqlite:///./agentcore.db
SQLALCHEMY_ECHO=false

# Ollama LLM
OLLAMA_URL=http://localhost:11434/api/generate
LLM_MODEL=mistral
LLM_TIMEOUT=60

# Model Storage
MODEL_PATH=./models/router_model.pkl
MODEL_SIGNATURE_PATH=./models/router_model.pkl.sig

# Security
JWT_SECRET_KEY=change-me-to-a-random-32-character-string-minimum
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
API_KEY=

# API Configuration
API_WORKERS=4
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/agentcore.log

# CORS
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8501

# Environment
ENVIRONMENT=development
AGENTCORE_DEBUG=false
